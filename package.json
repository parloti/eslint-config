{
  "name": "@codeperfect/eslint-config",
  "version": "1.0.0",
  "description": "A shareable flat ESLint config for TypeScript repositories",
  "keywords": [
    "eslint",
    "eslintconfig",
    "eslint-config",
    "typescript",
    "flat-config",
    "shareable-config"
  ],
  "homepage": "https://github.com/parloti/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/parloti/eslint-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parloti/eslint-config.git"
  },
  "license": "MIT",
  "author": "CodePerfect",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "\n# --------------- SCM --------------- #": "",
    "commit": "npx --yes git-cz",
    "postinstall": "patch-package",
    "prepare": "husky",
    "\n# --------------- BUILDING --------------- #": "",
    "build": "npm run clean && npm run compile && npm run resolve-paths",
    "clean": "npx --yes rimraf dist",
    "compile": "tsc --build --force ./tsconfig.build.json",
    "pack": "npm pack --pack-destination dist",
    "resolve-paths": "tsc-alias --project ./tsconfig.build.json --resolve-full-paths",
    "\n# --------------- LINTING --------------- #": "",
    "\t• --------------- checking --------------- •": "",
    "eslint": "npx --yes eslint --max-warnings=0",
    "lint": "npm run lint:run",
    "lint:run": "npm run prettier && npm run eslint",
    "lint:staged": "npx --yes tsx scripts/lint-staged.ts",
    "prettier": "npx --yes prettier --ignore-unknown --check .",
    "\n\t• --------------- fixing --------------- •": "",
    "eslint:fix": "npm run check:rules && npm run eslint -- --fix",
    "lint:fix": "npm run prettier:write && npm run eslint:fix",
    "prettier:write": "npm run prettier -- --write",
    "\n\t• --------------- helpers --------------- •": "",
    "check:rules": "npx --yes eslint-config-prettier eslint.config.ts",
    "eslint:inspect": "npx --yes @eslint/config-inspector",
    "\n# --------------- TESTING --------------- #": "",
    "typecheck": "tsc --noEmit",
    "typecheck:spec": "tsc --project tsconfig.spec.json --noEmit",
    "validate": "npm run lint && npm run typecheck && npm run typecheck:spec && npm run test && npm run build && npm run pack",
    "\n\t• --------------- unit --------------- •": "",
    "e2e": "npx --yes vitest run --config vitest.config.e2e.ts --coverage.enabled=false",
    "mutation": "npx --yes stryker run",
    "tdd:notify": "npm run tdd -- --notify",
    "tdd": "npx --yes vitest run --watch --silent=true --coverage.enabled=false",
    "test": "npm run unit && npm run e2e && npm run mutation",
    "unit": "npx --yes vitest run",
    "\n# --------------- DOCS --------------- #": "",
    "docs:api": "npx --yes typedoc --options typedoc.json",
    "docs:clean": "npx --yes rimraf docs/api",
    "docs": "npm run docs:clean && npm run docs:api"
  },
  "dependencies": {
    "minimatch": "^10.2.5"
  },
  "peerDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  },
  "optionalDependencies": {
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/eslint-plugin": "^1.6.18",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jasmine": "^4.2.2",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-jsdoc": "^63.0.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-rxjs-x": "^1.0.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.6.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@codeperfect/commitlint-config-emoji": "^1.0.0",
    "@codeperfect/eslint-config": "^1.10.0",
    "@codeperfect/eslint-plugin": "^2.2.0",
    "@commitlint/config-conventional": "^21.0.1",
    "@commitlint/cz-commitlint": "^21.0.2",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/eslint-plugin": "^1.6.18",
    "chalk": "^5.6.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsdoc": "^63.0.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.6",
    "lodash-es": "^4.18.1",
    "patch-package": "^8.0.1",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.3",
    "tsc-alias": "^1.8.17",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
